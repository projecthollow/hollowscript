enum Shape {
    Circle(Float),
    Rect(Float, Float),
    Empty,
}

fn area(s: Shape): Float {
    match s {
        Circle(r) {
            return 3.0 * r * r
        }
        Rect(w, h) {
            return w * h
        }
        Empty {
            return 0.0
        }
    }
}

return area(Shape.Rect(2.0, 4.5)) + area(Shape.Circle(2))
