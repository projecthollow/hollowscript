{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HollowScript",
  "scopeName": "source.hollowscript",
  "comment": "Derived from docs/spec/01-lexical-structure.md and docs/spec/18-grammar.md. A plain tokeniser: the language server's semantic tokens colour each name by its real declaration; this grammar only has to get comments, literals, keywords, declarations and punctuation right from the text alone, including inside string interpolations.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#filters" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "comment": "Section 1.2: '//' to the end of the line; there is no block comment.",
      "patterns": [
        {
          "comment": "A tagged comment: 'todo', 'explain' or 'note' in lower case directly followed by ':'.",
          "match": "(//)[ \\t]*(todo|explain|note)(:).*$",
          "name": "comment.line.double-slash.tagged.hollowscript",
          "captures": {
            "1": { "name": "punctuation.definition.comment.hollowscript" },
            "2": { "name": "keyword.other.tag.hollowscript" }
          }
        },
        {
          "match": "(//).*$",
          "name": "comment.line.double-slash.hollowscript",
          "captures": { "1": { "name": "punctuation.definition.comment.hollowscript" } }
        }
      ]
    },
    "strings": {
      "comment": "Section 1.5: double quoted, on one line (a raw line terminator ends it, HS0006), with backslash escapes and ${...} interpolation, which may contain any expression, record literals and nested strings included.",
      "name": "string.quoted.double.hollowscript",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hollowscript" } },
      "end": "(\")|$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.hollowscript" } },
      "patterns": [
        {
          "name": "constant.character.escape.hollowscript",
          "match": "\\\\([\"\\\\ntr$]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.hollowscript",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "comment": "${ expression }. Ends at the '}' that balances the braces opened inside it, or abnormally at the end of the line (HS0007).",
      "name": "meta.embedded.line.hollowscript",
      "contentName": "source.hollowscript",
      "begin": "\\$\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.hollowscript" } },
      "end": "\\}|(?=$)",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.hollowscript" } },
      "patterns": [
        { "include": "#interpolation-braces" },
        { "include": "$self" }
      ]
    },
    "interpolation-braces": {
      "comment": "A brace pair inside an interpolation (a record literal), so its '}' does not end the interpolation.",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.hollowscript" } },
      "end": "\\}|(?=$)",
      "endCaptures": { "0": { "name": "punctuation.definition.block.end.hollowscript" } },
      "patterns": [
        { "include": "#interpolation-braces" },
        { "include": "$self" }
      ]
    },
    "filters": {
      "comment": "Section 1.6: a backtick-delimited Filter literal on one line (HS0010 otherwise). Only \\` and \\\\ are escapes; any other backslash is kept verbatim. Its own grammar (Appendix A) is not tokenised here.",
      "name": "string.quoted.other.filter.hollowscript",
      "begin": "`",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hollowscript" } },
      "end": "(`)|$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.hollowscript" } },
      "patterns": [
        { "name": "constant.character.escape.hollowscript", "match": "\\\\[`\\\\]" }
      ]
    },
    "numbers": {
      "comment": "Section 1.4: Int and Float literals with optional '_' between digits and an optional exponent. No sign, no hexadecimal, no suffixes.",
      "patterns": [
        {
          "name": "constant.numeric.float.hollowscript",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?[eE][+-]?[0-9](?:_?[0-9])*\\b|\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.hollowscript",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "declarations": {
      "comment": "Section 18.4: the name a 'fn', 'record' or 'enum' declaration introduces. A 'fn' followed by '(' is a closure and has no name.",
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.hollowscript" },
            "2": { "name": "entity.name.function.hollowscript" }
          }
        },
        {
          "match": "\\b(record|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.hollowscript" },
            "2": { "name": "entity.name.type.hollowscript" }
          }
        }
      ]
    },
    "keywords": {
      "comment": "Section 1.3's 27 reserved words.",
      "patterns": [
        {
          "name": "keyword.control.hollowscript",
          "match": "\\b(if|else|for|in|while|match|break|continue|return)\\b"
        },
        {
          "name": "keyword.control.import.hollowscript",
          "match": "\\b(import|export|from|uses)\\b"
        },
        {
          "name": "storage.type.function.hollowscript",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.hollowscript",
          "match": "\\b(constant|variable|record|enum)\\b"
        },
        {
          "comment": "Section 9.3: the effect marker, on a call or a function type.",
          "name": "storage.modifier.effect.hollowscript",
          "match": "\\beffect\\b"
        },
        {
          "comment": "Reserved for a future version: any use is HS0104.",
          "name": "invalid.illegal.reserved.hollowscript",
          "match": "\\b(test|assert)\\b"
        },
        {
          "name": "keyword.operator.logical.hollowscript",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hollowscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.hollowscript",
          "match": "\\bnone\\b"
        },
        {
          "comment": "The discard name (section 1.3): not a keyword, and never readable.",
          "name": "variable.language.discard.hollowscript",
          "match": "\\b_\\b"
        }
      ]
    },
    "types": {
      "comment": "Section 2.1's prelude type names. Not keywords; the language server's semantic tokens override this where a program declares its own.",
      "name": "support.type.hollowscript",
      "match": "\\b(Int|Float|Bool|String|Filter|Result|Map|Set|MapEntry|Json|JsonError|TimeParts|IoError|HttpError|HttpRequest|HttpResponse)\\b"
    },
    "operators": {
      "comment": "Section 1.7. There is no '!', '%', '&&', '||' or compound assignment; a '!' not followed by '=' is HS0005.",
      "patterns": [
        { "name": "keyword.operator.comparison.hollowscript", "match": "==|!=|<=|>=|<|>" },
        { "name": "invalid.illegal.character.hollowscript", "match": "!" },
        { "name": "keyword.operator.range.hollowscript", "match": "\\.\\." },
        { "name": "keyword.operator.optional.hollowscript", "match": "\\?" },
        { "name": "keyword.operator.assignment.hollowscript", "match": "=" },
        { "name": "keyword.operator.arithmetic.hollowscript", "match": "[-+*/]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brace.round.hollowscript", "match": "[()]" },
        { "name": "punctuation.brace.square.hollowscript", "match": "[\\[\\]]" },
        { "name": "punctuation.brace.curly.hollowscript", "match": "[{}]" },
        { "name": "punctuation.separator.comma.hollowscript", "match": "," },
        { "name": "punctuation.separator.colon.hollowscript", "match": ":" },
        { "name": "punctuation.accessor.hollowscript", "match": "\\." }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "A call: name(...).",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
          "name": "entity.name.function.call.hollowscript"
        },
        {
          "comment": "A capitalised name is a type, an enum or a variant (sections 18.4 and 18.7).",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.hollowscript"
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.readwrite.hollowscript"
        }
      ]
    }
  }
}
